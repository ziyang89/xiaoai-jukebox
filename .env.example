# 复制为 .env 后按需修改（docker compose 会自动读取）

# 网页端口
JB_PORT=58092

# 音箱能访问到的本服务地址 —— 填你机器的内网 IP
JB_PUBLIC_BASE=http://192.168.1.100:58092

# 播放引擎（songloft）地址
JB_ENGINE_BASE=http://192.168.1.100:58091

# 音箱 device_id：在播放引擎的设备列表里能看到，形如 xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JB_ENGINE_DEVICE=

# 音量 0-100
JB_VOLUME=15

# 宿主机上的目录（留空则用仓库内的 ./data）
MUSIC_DIR=./data/music
DATA_DIR=./data/jukebox
